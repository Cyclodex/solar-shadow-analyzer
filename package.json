{
  "name": "solar-shadow-analyzer",
  "version": "2.0.0",
  "private": true,
  "description": "Verschattungsanalyse für geneigt an übereinanderliegenden Balkongeländern hängende Solarpanels: exakte 3D-Verschattung, Jahresertrag mit Open-Meteo-Wetterdaten, Geländehorizont und Wirtschaftlichkeit (DE/EN)",
  "license": "MIT",
  "author": "Fabian Gander",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cyclodex/solar-shadow-analyzer.git"
  },
  "homepage": "https://github.com/Cyclodex/solar-shadow-analyzer#readme",
  "bugs": {
    "url": "https://github.com/Cyclodex/solar-shadow-analyzer/issues"
  },
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "e2e": "playwright test",
    "validate:terrain": "tsx scripts/validate-terrain.ts",
    "validate:yield": "tsx scripts/validate-yield.ts",
    "icons": "tsx scripts/generate-icons.ts"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.8.0",
    "fast-png": "^8.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
